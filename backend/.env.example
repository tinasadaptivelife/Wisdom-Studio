# Get a free key at https://aihorde.net/register (or use the shared
# anonymous key below for testing — much lower priority in the generation
# queue, so expect slower results).
AI_HORDE_API_KEY=0000000000

# Optional. Images are shared with the LAION dataset by default (this makes each
# generation cheaper). Set to false to keep images private, for example for
# unpublished artwork.
# WISDOM_STUDIO_SHARE_IMAGES=false

# Optional. An email or URL AI Horde can reach you at; sent as the contact part
# of this app's Client-Agent header. Defaults to "local-dev".
# AI_HORDE_CONTACT=you@example.com

# Optional. Folder with your brands (palettes, fonts, image styles), kept
# outside this repo. Defaults to ~/.wisdom-studio/brands. With no folder there,
# the app uses its one built-in look. See docs/brand-packs.md.
# WISDOM_STUDIO_BRANDS_DIR=/path/to/your/brand-pack
